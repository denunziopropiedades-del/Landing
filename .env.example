# ── Sitio ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://matulotes.app

# ── Supabase (base de datos + auth del panel admin) ─────────────────────
# Proyecto > Settings > API en supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudinary (subida de fotos/videos desde el panel admin) ────────────
# Dashboard > Settings > Upload > Upload presets (crear uno "unsigned")
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ── Mercado Pago (pago de seña online) ──────────────────────────────────
# Panel de desarrolladores > Credenciales de producción
MERCADOPAGO_ACCESS_TOKEN=
# Panel de desarrolladores > Webhooks > Firma secreta (para /api/mercadopago/webhook)
MERCADOPAGO_WEBHOOK_SECRET=

# ── Resend (emails de notificación de reservas/consultas) ───────────────
RESEND_API_KEY=
EMAIL_FROM="Matu Lotes <no-reply@matulotes.app>"
EMAIL_TO=denunziopropiedades@gmail.com

# ── Cron de fechas especiales (cumpleaños, Navidad, Año Nuevo, etc.) ─────
# Cadena secreta cualquiera, para que solo Vercel Cron pueda disparar el
# envío de estos emails (ver README > "Fechas especiales para clientes").
CRON_SECRET=

# ── Google Maps ──────────────────────────────────────────────────────────
# Opcional: URL de embed de Google Maps (Compartir > Insertar mapa > copiar
# el valor del atributo src del iframe). Si se omite, se usa una ubicación
# por defecto de Guernica, Buenos Aires.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# ── Google Calendar (sincronizar la agenda de visitas) ───────────────────
# Service Account de Google Cloud con la Calendar API habilitada, compartida
# con permiso de edición en el calendario que quieras sincronizar.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_TIMEZONE=America/Argentina/Buenos_Aires

# ── Meta Lead Ads (leads de formularios de Facebook/Instagram al CRM) ───
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# ── Alternativa vía Zapier (Zap: "Facebook Lead Ads" → "Webhooks by Zapier") ─
ZAPIER_WEBHOOK_SECRET=

# ── Analítica / Marketing ────────────────────────────────────────────────
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# Podés poner varios Pixels separados por coma, ej: 2954085414942499,2500936630361675

# ── Rate limiting distribuido (opcional) ─────────────────────────────────
# Sin esto, los endpoints públicos usan un límite en memoria por instancia.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
